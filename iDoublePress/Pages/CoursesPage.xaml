<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.CoursesPage"
             x:DataType="pageModels:CoursesPageModel"
             x:Name="CoursesPageView"
             Title="{ext:Translate Courses}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CoursesPageView}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
    </ContentPage.Behaviors>

    <!-- Single-cell grid so the floating + button can overlay the scrollable content -->
    <Grid Padding="{StaticResource LayoutPadding}">

        <!-- Scrollable table -->
        <CollectionView ItemsSource="{Binding Courses}"
                        SelectionMode="None"
                        VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Course">
                    <Border Style="{StaticResource CardStyle}" Margin="0,5">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              Padding="8"
                              ColumnSpacing="10"
                              VerticalOptions="Center">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" Style="{StaticResource Body1}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding TotalPar, StringFormat='Par {0}'}" Style="{StaticResource Caption1}" Opacity="0.8" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="{ext:Translate Copy}"
                                    Clicked="CopyButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Button Grid.Column="2" Text="{ext:Translate Edit}"
                                    Clicked="EditButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Button Grid.Column="3" Text="{ext:Translate Delete}"
                                    Clicked="DeleteButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating Add Button -->
        <Button Text="+"
                Command="{Binding AddCourseCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="32"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,16"
                AutomationId="CoursesPage.AddCourse"
                Shadow="{Shadow Brush={StaticResource Gray900}, Offset='0,2', Radius='8', Opacity='0.3'}" />

    </Grid>

</ContentPage>
