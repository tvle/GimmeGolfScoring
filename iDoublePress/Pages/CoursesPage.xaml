<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.CoursesPage"
             x:DataType="pageModels:CoursesPageModel"
             x:Name="CoursesPageView"
             Title="{Binding CourseCount, StringFormat='Courses ({0})'}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CoursesPageView}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
    </ContentPage.Behaviors>

    <Grid Padding="{StaticResource LayoutPadding}"
          RowDefinitions="Auto,*"
          RowSpacing="10">

        <!-- Header row: sort buttons + add button -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="10"
              VerticalOptions="Center">

            <Button Grid.Column="0"
                    ImageSource="{StaticResource IconSortAsc}"
                    Command="{Binding SortByNameAscCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    VerticalOptions="Center"
                    AutomationId="CoursesPage.SortAsc" />

            <Button Grid.Column="1"
                    ImageSource="{StaticResource IconSortDesc}"
                    Command="{Binding SortByNameDescCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    VerticalOptions="Center"
                    AutomationId="CoursesPage.SortDesc" />

            <Button Grid.Column="3"
                    Text="+"
                    Command="{Binding AddCourseCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    FontSize="26"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    AutomationId="CoursesPage.AddCourse" />
        </Grid>

        <!-- Scrollable table -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Courses}"
                        SelectionMode="None"
                        VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CourseWithLastPlayed">
                    <Border Style="{StaticResource CardStyle}" Margin="0,5">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              Padding="8"
                              ColumnSpacing="10"
                              RowSpacing="6"
                              VerticalOptions="Center">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="4"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Body1}"
                                   LineBreakMode="TailTruncation" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding TotalPar, StringFormat='Par {0}'}"
                                   Style="{StaticResource Caption1}"
                                   Opacity="0.8"
                                   VerticalOptions="Center" />

                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    ImageSource="{StaticResource IconCopy}"
                                    Clicked="CopyButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    ImageSource="{StaticResource IconEdit}"
                                    Clicked="EditButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Button Grid.Row="1"
                                    Grid.Column="3"
                                    ImageSource="{StaticResource IconDelete}"
                                    Clicked="DeleteButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="4"
                                   Text="{Binding LastPlayedDisplay}"
                                   IsVisible="{Binding HasLastPlayed}"
                                   Style="{StaticResource Caption1}"
                                   Opacity="0.6"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
