<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.CoursesPage"
             x:DataType="pageModels:CoursesPageModel"
             x:Name="CoursesPageView"
             Title="{ext:Translate Courses}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CoursesPageView}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
    </ContentPage.Behaviors>

    <Grid Padding="{StaticResource LayoutPadding}">
        <CollectionView ItemsSource="{Binding Courses}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCourse, Mode=TwoWay}"
                        SelectionChangedCommand="{Binding OpenCourseCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedCourse}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Course">
                    <Border Style="{StaticResource CardStyle}" Margin="0,5">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Title3}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding TotalPar, StringFormat='Par {0}'}" Style="{StaticResource Caption1}" />
                            <Label Grid.RowSpan="2" Grid.Column="1" Text=">" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating Add Button -->
        <Button Text="+"
                Command="{Binding AddCourseCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="32"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,16"
                AutomationId="CoursesPage.AddCourse"
                Shadow="{Shadow Brush={StaticResource Gray900}, Offset='0,2', Radius='8', Opacity='0.3'}" />
    </Grid>

</ContentPage>
