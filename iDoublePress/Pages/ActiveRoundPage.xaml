<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:iDoublePress.Converters"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
             x:Class="iDoublePress.Pages.ActiveRoundPage"
             x:DataType="pageModels:ActiveRoundPageModel"
             x:Name="RoundPage"
             AutomationId="ActiveRoundPage"
             Title="{Binding CurrentRound.Course.Name, FallbackValue='Standard Course'}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:SubtractOneConverter x:Key="SubtractOneConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:FairwayPenaltyEnabledConverter x:Key="FairwayPenaltyEnabledConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:NullableIntToDashConverter x:Key="NullableIntToDashConverter" />
            <converters:HoleNumberWidthConverter x:Key="HoleNumberWidthConverter" />
            <converters:IsActiveHoleConverter x:Key="IsActiveHoleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="0">

        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="10,8,10,8"
                Padding="0"
                AutomationId="ActiveRoundPage.Header"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="0" Padding="4">
                <!-- Score and Score Display -->
                <Grid Grid.Row="0" 
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,0,0,0">
                    <!-- Total Putts (left) -->
                    <VerticalStackLayout Grid.Column="0" 
                                        VerticalOptions="Center"
                                        HorizontalOptions="Start"
                                        Spacing="-2">
                        <Label Text="{Binding TotalPutts}"
                               AutomationId="ActiveRoundPage.TotalPutts"
                               Style="{StaticResource Caption1}"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Label Text="{ext:Translate Putts}"
                               Style="{StaticResource Title1}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>

                    <!-- Score (center) -->
                    <HorizontalStackLayout Grid.Column="1" Margin="0,0,0,0"
                                          HorizontalOptions="Center" 
                                          Spacing="6">
                        <Label Text="{Binding CurrentRound.TotalScore, FallbackValue='4'}" 
                               AutomationId="ActiveRoundPage.TotalScore"
                               Style="{StaticResource Display}"
                               FontSize="56"
                               VerticalTextAlignment="Center"/>
                        <Label Text="{Binding TotalScoreDisplay, FallbackValue='(E)'}" 
                               AutomationId="ActiveRoundPage.TotalScoreDisplay"
                               Style="{StaticResource Title1}"
                               FontSize="24"
                               VerticalTextAlignment="Center"
                               Margin="0,0,0,6"/>
                        <Label Text="{Binding CourseParDisplay}" 
                               AutomationId="ActiveRoundPage.CoursePar"
                               Style="{StaticResource Caption1}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               Margin="0,0,0,0"/>

                    </HorizontalStackLayout>

                    <!-- Total GIR (right) -->
                    <VerticalStackLayout Grid.Column="2" 
                                        VerticalOptions="Center"
                                        HorizontalOptions="End"
                                        Spacing="0">
                        <Label Text="{Binding TotalGIR}"
                               AutomationId="ActiveRoundPage.TotalGIR"
                               Style="{StaticResource Caption1}"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Label Text="{ext:Translate GIR}"
                               Style="{StaticResource Title1}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </Grid>
                <!-- Hole Numbers and Scores with Active Indicator -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="0" HorizontalOptions="Center">
                    <!-- Scores Row -->
                    <CollectionView Grid.Row="0"
                                   ItemsSource="{Binding CurrentRound.Holes}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   HeightRequest="24"
                                   ItemsUpdatingScrollMode="KeepScrollOffset"
                                   HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="1"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Hole">
                                <Grid WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                      HorizontalOptions="Start"
                                      VerticalOptions="Center">
                                    <Button FontFamily="OpenSansRegular"
                                            FontSize="20"
                                            Padding="0"
                                            Margin="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            CornerRadius="0"
                                            HeightRequest="24"
                                            WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsScored}" Value="True">
                                                <Setter Property="Text" Value="{Binding Score}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsScored}" Value="False">
                                                <Setter Property="Text" Value="–"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsActiveHoleConverter}">
                                                        <Binding Path="HoleNumber"/>
                                                        <Binding Path="CurrentHoleIndex" Source="{RelativeSource AncestorType={x:Type pageModels:ActiveRoundPageModel}}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="FontAttributes" Value="Bold"/>
                                                <Setter Property="FontSize" Value="24"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Hole Numbers Row -->
                    <CollectionView Grid.Row="3"
                                   ItemsSource="{Binding CurrentRound.Holes}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   HeightRequest="20"
                                   ItemsUpdatingScrollMode="KeepScrollOffset"
                                   HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="1"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Hole">
                                <Grid WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                      HorizontalOptions="Start"
                                      VerticalOptions="Center">
                                    <Button Text="{Binding HoleNumber}"
                                            FontFamily="OpenSansRegular"
                                            FontSize="13"
                                            Padding="0"
                                            Margin="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            CornerRadius="0"
                                            HeightRequest="20"
                                            WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:ActiveRoundPageModel}}, Path=NavigateToHoleCommand}"
                                            CommandParameter="{Binding HoleNumber, Converter={StaticResource SubtractOneConverter}}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsActiveHoleConverter}">
                                                        <Binding Path="HoleNumber"/>
                                                        <Binding Path="CurrentHoleIndex" Source="{RelativeSource AncestorType={x:Type pageModels:ActiveRoundPageModel}}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="FontAttributes" Value="Bold"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

            </Grid>
        </Border>

        <!-- Main Scorecard (now vertically scrollable if needed) -->
        <ScrollView Grid.Row="1" Margin="10,0,10,0" HorizontalOptions="Fill"
                    AutomationId="ActiveRoundPage.Scorecard.Scroll"
                    IsVisible="{Binding CurrentHole, Converter={StaticResource IsNotNullConverter}}"
                    Orientation="Vertical"
                    Padding="0">
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid Padding="4" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="6">
                    <!-- Compact top row: hole number (left) / FH (center) / Par (right) -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="#" />
                        <Label Text="{Binding CurrentHoleNumberDisplay}"
                                Style="{StaticResource Title1}"
                                FontSize="32"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                AutomationId="ActiveRoundPage.HoleNumber" />
                        <Label Text="{Binding CurrentParNumberDisplay}" Margin="10,0,0,0"
                            Style="{StaticResource Title2}"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            AutomationId="ActiveRoundPage.Par" />
                    </HorizontalStackLayout>
                    <Label Grid.Row="0" Grid.Column="1" Text="{ext:Translate FairwayHit}" 
                                Style="{StaticResource Title3}" 
                                HorizontalTextAlignment="Center" VerticalTextAlignment="End" VerticalOptions="End"
                                FontSize="20" />
                    <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="Auto, 50" HorizontalOptions="End">
                        <Button Text="&#x2316;"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                Command="{Binding ShowGPSPageCommand}" />
                        <Label Grid.Column="1" Text="{Binding CurrentHole.Yardage, Converter={StaticResource NullableIntToDashConverter}}"
                           AutomationId="ActiveRoundPage.Navigation.CurrentHoleYardage"
                           Style="{StaticResource Title2}"
                           HorizontalOptions="End"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>    
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <Label Text="&#x26A0;"
                                   FontFamily="FluentSystemIcons-Regular"
                                   Style="{StaticResource Title1}"                               
                                   FontSize="20" TextColor="Red"
                                   VerticalOptions="End" HorizontalOptions="Start"
                                   Margin="0,0,0,0"
                                   AutomationProperties.Name="{ext:Translate Penalty}" />
                        <Switch IsToggled="{Binding CurrentHole.Penalties, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}}"
                                    OnColor="{StaticResource Primary}" Margin="0,0,0,0" HorizontalOptions="Start"
                                    Scale="1" />
                    </VerticalStackLayout>
                    <!-- FH Buttons -->
                    <sf:SfSegmentedControl Grid.Row="1" Grid.Column="1" x:Name="FairwaySegmentedControl" WidthRequest="150"
                                            SegmentWidth="50"
                                            CornerRadius="16" HorizontalOptions="Center"
                                            SelectedIndex="{Binding CurrentHole.FairwayResultIndex, Mode=TwoWay}"
                                            SelectionMode="SingleDeselect">
                        <sf:SfSegmentedControl.ItemsSource>
                            <x:Array Type="{x:Type sf:SfSegmentItem}">
                                <sf:SfSegmentItem Text="&lt;&lt;&lt;" Width="50" />
                                <sf:SfSegmentItem Text="OOO" Width="50" />
                                <sf:SfSegmentItem Text="&gt;&gt;&gt;" Width="50" />
                            </x:Array>
                        </sf:SfSegmentedControl.ItemsSource>
                    </sf:SfSegmentedControl>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="0" VerticalOptions="Center">
                        <Label Text="{ext:Translate GIR}"
                               Style="{StaticResource Title1}"
                               FontSize="20" HorizontalOptions="End"
                               VerticalOptions="End" Margin="0,0,0,0"/>
                        <Switch IsToggled="{Binding CurrentHole.GreenInRegulation, Mode=TwoWay}" HorizontalOptions="End"
                                    AutomationId="ActiveRoundPage.GIR.Switch" Margin="0,0,0,0"
                                    OnColor="{StaticResource Primary}"
                                    Scale="1" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.RowSpan="4" Spacing="0" >
                        <Label Text="{ext:Translate Putts}"
                                   Style="{StaticResource Title1}" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                        <Grid ColumnDefinitions="Auto,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="0"
                                  VerticalOptions="Center">
                            <VerticalStackLayout Grid.RowSpan="2" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Button Text="-"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Command="{Binding DecreasePuttsCommand}"
                                            IsEnabled="{Binding CanDecreasePutts}" />
                                <Label Grid.RowSpan="2" Grid.Column="1"
                                       Text="{Binding CurrentHole.Putts, Converter={StaticResource NullableIntToDashConverter}}"
                                       Style="{StaticResource Title2}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"
                                       MinimumWidthRequest="26" />
                                <Button Text="+"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Command="{Binding IncreasePuttsCommand}"
                                            IsEnabled="{Binding CanIncreasePutts}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Button Grid.Row="3" Grid.Column="1"
                                Text="-" 
                                AutomationId="ActiveRoundPage.DecreaseScore"
                                Command="{Binding DecreaseScoreCommand}"
                                IsEnabled="{Binding CanDecreaseScore}"
                                HeightRequest="40"
                                Padding="0,0,0,0"
                                FontSize="28"
                                Margin="0,0,0,0" />

                    <!-- Proximity (right) -->
                    <VerticalStackLayout Grid.Row="3" Grid.Column="2" Grid.RowSpan="5" Spacing="0">
                        <RadioButton GroupName="Proximity"
                                         HorizontalOptions="End" 
                                         FlowDirection="RightToLeft" Margin="0,-0,0,0"
                                         IsChecked="{Binding IsProximityS, Mode=TwoWay}" />
                        <Label Text="{ext:LocalizedUnits ProximityS}" HorizontalTextAlignment="End" Margin="0,-14,0,0" />

                        <RadioButton GroupName="Proximity"
                                         HorizontalOptions="End"
                                         FlowDirection="RightToLeft"
                                         IsChecked="{Binding IsProximityM, Mode=TwoWay}" />
                        <Label Text="{ext:LocalizedUnits ProximityM}" HorizontalTextAlignment="End" Margin="0,-14,0,0" />

                        <RadioButton GroupName="Proximity"
                                         HorizontalOptions="End"
                                         FlowDirection="RightToLeft"
                                         IsChecked="{Binding IsProximityL, Mode=TwoWay}" />
                        <Label Text="{ext:LocalizedUnits ProximityL}" HorizontalTextAlignment="End" Margin="0,-14,0,0" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Row="4" Grid.Column="1" HorizontalOptions="Center">
                        <Border 
                                AutomationId="ActiveRoundPage.ScoreDisplayContainer"
                                BackgroundColor="{Binding CurrentHole.ScoreColor, FallbackValue={StaticResource Primary}}"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="0"
                                VerticalOptions="Fill">
                        <Label Text="{Binding CurrentHole.Score, FallbackValue='4'}"
                                    AutomationId="ActiveRoundPage.ScoreValue"
                                    Style="{StaticResource Display}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    Margin="0,0,0,0"/>
                        </Border>
                        <Label 
                                Text="{Binding CurrentHole.ScoreRelativeToPar, StringFormat='{0:+0;-#;E}', FallbackValue='E'}"
                                AutomationId="ActiveRoundPage.ScoreRelativeToPar"
                                Style="{StaticResource Title2}"
                                HorizontalTextAlignment="Center"
                                Margin="0" />

                    </HorizontalStackLayout>
                    <Button Grid.Row="5" Grid.Column="1"
                                Text="+"
                                AutomationId="ActiveRoundPage.IncreaseScore"
                                Command="{Binding IncreaseScoreCommand}"
                                HeightRequest="40"
                                Padding="0,-0,0,0"
                                FontSize="28"
                                Margin="0" />
                </Grid>
            </Border>
        </ScrollView>

        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}"
                Margin="10,8,10,8"
                Padding="4"
                AutomationId="ActiveRoundPage.NavigationBar"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <!-- Navigation Buttons -->
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Text="&lt;"
                        WidthRequest="72"
                        HeightRequest="44"
                        Padding="0,-0,0,0"
                        AutomationId="ActiveRoundPage.PreviousHole"
                        Command="{Binding PreviousHoleCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        HorizontalOptions="Start"/>

                <Button Grid.Column="1"
                        Text="&gt;"
                        WidthRequest="72"
                        HeightRequest="44"
                        Padding="0,-0,0,0"
                        AutomationId="ActiveRoundPage.NextHole"
                        Command="{Binding NextHoleCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsLastHole, Converter={StaticResource InvertedBoolConverter}}"/>
                
                <Button Grid.Column="1"
                    Text="{ext:Translate CompleteRound}"
                    AutomationId="ActiveRoundPage.Complete"
                    Command="{Binding CompleteRoundCommand}"
                    HeightRequest="44"
                    Padding="0,-0,0,0"
                    BackgroundColor="{StaticResource Primary}"
                    HorizontalOptions="Center"                        
                    IsVisible="{Binding IsLastHole}"/>

            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" 
              AutomationId="ActiveRoundPage.LoadingOverlay"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                             AutomationId="ActiveRoundPage.LoadingIndicator"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Color="{StaticResource Primary}"/>
        </Grid>
    </Grid>
</ContentPage>
