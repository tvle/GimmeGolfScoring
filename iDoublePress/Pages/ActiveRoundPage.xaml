<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:iDoublePress.Converters"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
             x:Class="iDoublePress.Pages.ActiveRoundPage"
             x:DataType="pageModels:ActiveRoundPageModel"
             x:Name="RoundPage"
             AutomationId="ActiveRoundPage"
             Title="{ext:Translate ActiveRound}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:SubtractOneConverter x:Key="SubtractOneConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:FairwayPenaltyEnabledConverter x:Key="FairwayPenaltyEnabledConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:NullableIntToDashConverter x:Key="NullableIntToDashConverter" />
            <converters:HoleNumberWidthConverter x:Key="HoleNumberWidthConverter" />
            <converters:IsActiveHoleConverter x:Key="IsActiveHoleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="0">

        <!-- Header: Course Info with Hole Navigation -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="15,15,15,8"
                Padding="12"
                AutomationId="ActiveRoundPage.Header"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                <!-- Course Name - Centered and Truncated -->
                <Label Grid.Row="0"
                       Text="{Binding CurrentRound.Course.Name, FallbackValue='Standard Course'}" 
                       AutomationId="ActiveRoundPage.CourseName"
                       Style="{StaticResource Title1}"
                       FontSize="26"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>

                <!-- Course Par - Centered below course name -->
                <Label Grid.Row="1"
                       Text="{Binding CourseParDisplay}" 
                       AutomationId="ActiveRoundPage.CoursePar"
                       Style="{StaticResource Caption1}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       Margin="0,-4,0,0"/>

                <!-- Score and Score Display -->
                <Grid Grid.Row="2" 
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,-20,0,0">
                    <!-- Total Putts (left) -->
                    <VerticalStackLayout Grid.Column="0" 
                                        VerticalOptions="Center"
                                        HorizontalOptions="Start"
                                        Spacing="-2">
                        <Label Text="{Binding TotalPutts}"
                               AutomationId="ActiveRoundPage.TotalPutts"
                               Style="{StaticResource Caption1}"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Label Text="putts"
                               Style="{StaticResource Caption1}"
                               FontSize="10"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                    
                    <!-- Score (center) -->
                    <HorizontalStackLayout Grid.Column="1" 
                                          HorizontalOptions="Center" 
                                          Spacing="6">
                        <Label Text="{Binding CurrentRound.TotalScore, FallbackValue='4'}" 
                               AutomationId="ActiveRoundPage.TotalScore"
                               Style="{StaticResource Display}"
                               FontSize="56"
                               VerticalTextAlignment="Center"/>
                        <Label Text="{Binding TotalScoreDisplay, FallbackValue='(E)'}" 
                               AutomationId="ActiveRoundPage.TotalScoreDisplay"
                               Style="{StaticResource Title1}"
                               FontSize="24"
                               VerticalTextAlignment="Center"
                               Margin="0,0,0,6"/>
                    </HorizontalStackLayout>

                    <!-- Total GIR (right) -->
                    <VerticalStackLayout Grid.Column="2" 
                                        VerticalOptions="Center"
                                        HorizontalOptions="End"
                                        Spacing="-2">
                        <Label Text="{Binding TotalGIR}"
                               AutomationId="ActiveRoundPage.TotalGIR"
                               Style="{StaticResource Caption1}"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Label Text="GIR"
                               Style="{StaticResource Caption1}"
                               FontSize="10"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Hole Numbers and Scores with Active Indicator -->
                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="0" HorizontalOptions="CenterAndExpand">
                    <!-- Scores Row -->
                    <CollectionView Grid.Row="0"
                                   ItemsSource="{Binding CurrentRound.Holes}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   HeightRequest="24"
                                   ItemsUpdatingScrollMode="KeepScrollOffset"
                                   HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="1"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Hole">
                                <Grid WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                      HorizontalOptions="Start"
                                      VerticalOptions="Center">
                                    <Button FontFamily="OpenSansRegular"
                                            FontSize="20"
                                            Padding="0"
                                            Margin="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            CornerRadius="0"
                                            HeightRequest="24"
                                            WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsScored}" Value="True">
                                                <Setter Property="Text" Value="{Binding Score}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsScored}" Value="False">
                                                <Setter Property="Text" Value="–"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsActiveHoleConverter}">
                                                        <Binding Path="HoleNumber"/>
                                                        <Binding Path="CurrentHoleIndex" Source="{RelativeSource AncestorType={x:Type pageModels:ActiveRoundPageModel}}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="FontAttributes" Value="Bold"/>
                                                <Setter Property="FontSize" Value="24"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Hole Numbers Row -->
                    <CollectionView Grid.Row="1"
                                   ItemsSource="{Binding CurrentRound.Holes}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   HeightRequest="20"
                                   ItemsUpdatingScrollMode="KeepScrollOffset"
                                   HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="1"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Hole">
                                <Grid WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                      HorizontalOptions="Start"
                                      VerticalOptions="Center">
                                    <Button Text="{Binding HoleNumber}"
                                            FontFamily="OpenSansRegular"
                                            FontSize="13"
                                            Padding="0"
                                            Margin="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            CornerRadius="0"
                                            HeightRequest="20"
                                            WidthRequest="{Binding HoleNumber, Converter={StaticResource HoleNumberWidthConverter}}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:ActiveRoundPageModel}}, Path=NavigateToHoleCommand}"
                                            CommandParameter="{Binding HoleNumber, Converter={StaticResource SubtractOneConverter}}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsActiveHoleConverter}">
                                                        <Binding Path="HoleNumber"/>
                                                        <Binding Path="CurrentHoleIndex" Source="{RelativeSource AncestorType={x:Type pageModels:ActiveRoundPageModel}}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="FontAttributes" Value="Bold"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Scorecard (non-scrolling; fits on screen) -->
        <Grid Grid.Row="1"
              AutomationId="ActiveRoundPage.Scorecard"
              IsVisible="{Binding CurrentHole, Converter={StaticResource IsNotNullConverter}}"
              Padding="15,0,15,0">

            <Border Style="{StaticResource CardStyle}" Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="6">

                    <!-- Compact top row: hole number (left) / FH (center) / Par (right) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{Binding CurrentHoleNumberDisplay}"
                               Style="{StaticResource Title1}"
                               FontSize="32"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"
                               AutomationId="ActiveRoundPage.HoleNumber" />

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="FH" 
                                   Style="{StaticResource Title3}" 
                                   HorizontalTextAlignment="Center"
                                   FontSize="14" />
                            <sf:SfSegmentedControl x:Name="FairwaySegmentedControl"
                                                   SegmentHeight="28"
                                                   SegmentWidth="52"
                                                   CornerRadius="16"
                                                   HorizontalOptions="Center"
                                                   SelectedIndex="{Binding CurrentHole.FairwayResultIndex, Mode=TwoWay}">
                                <sf:SfSegmentedControl.ItemsSource>
                                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                                        <sf:SfSegmentItem Text="&lt;&lt;&lt;" />
                                        <sf:SfSegmentItem Text="OOO" />
                                        <sf:SfSegmentItem Text="&gt;&gt;&gt;" />
                                    </x:Array>
                                </sf:SfSegmentedControl.ItemsSource>
                            </sf:SfSegmentedControl>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding CurrentParNumberDisplay}"
                               Style="{StaticResource Title2}"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               AutomationId="ActiveRoundPage.Par" />
                    </Grid>

                    <!-- Compact stats sub-row: Penalty (left) / GIR (right) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center" AutomationId="ActiveRoundPage.Stats">
                        <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="&#x26A0;"
                                   FontFamily="FluentSystemIcons-Regular"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   Margin="0,-6,-10,0"
                                   AutomationProperties.Name="Penalty" />
                            <Switch IsToggled="{Binding CurrentHole.Penalties, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}}"
                                    OnColor="{StaticResource Primary}"
                                    Scale="0.75" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                            <Label Text="GIR" Style="{StaticResource Title3}" VerticalOptions="Center" FontSize="14" Margin="0,0,-10,0" />
                            <Switch IsToggled="{Binding CurrentHole.GreenInRegulation, Mode=TwoWay}"
                                    AutomationId="ActiveRoundPage.GIR.Switch"
                                    OnColor="{StaticResource Primary}"
                                    Scale="0.75" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Score / Putts / Proximity row -->
                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,2*,*"
                          ColumnSpacing="14"
                          VerticalOptions="Fill">

                        <!-- Putts (left) -->
                        <VerticalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                            <Label Text="Putts"
                                   Style="{StaticResource Caption1}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                            <Grid ColumnDefinitions="Auto,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8"
                                  VerticalOptions="Center">

                                <!-- +/- stacked vertically -->
                                <VerticalStackLayout Grid.RowSpan="2" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Button Text="-"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Command="{Binding DecreasePuttsCommand}"
                                            IsEnabled="{Binding CanDecreasePutts}" />

                                    <Button Text="+"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Command="{Binding IncreasePuttsCommand}"
                                            IsEnabled="{Binding CanIncreasePutts}" />
                                </VerticalStackLayout>

                                <!-- value centered next to buttons -->
                                <Label Grid.RowSpan="2" Grid.Column="1"
                                       Text="{Binding CurrentHole.Putts, Converter={StaticResource NullableIntToDashConverter}}"
                                       Style="{StaticResource Title2}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"
                                       MinimumWidthRequest="26" />

                            </Grid>
                        </VerticalStackLayout>

                        <!-- Center score controls -->
                        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="2" VerticalOptions="Fill">
                            <Button Grid.Row="0"
                                    Text="-"
                                    AutomationId="ActiveRoundPage.DecreaseScore"
                                    Command="{Binding DecreaseScoreCommand}"
                                    IsEnabled="{Binding CanDecreaseScore}"
                                    HeightRequest="40"
                                    Padding="0"
                                    FontSize="28"
                                    Margin="0" />

                            <Border Grid.Row="1"
                                    AutomationId="ActiveRoundPage.ScoreDisplayContainer"
                                    BackgroundColor="{Binding CurrentHole.ScoreColor, FallbackValue={StaticResource Primary}}"
                                    StrokeThickness="0"
                                    Padding="0"
                                    Margin="0"
                                    VerticalOptions="Fill">
                                <Label Text="{Binding CurrentHole.Score, FallbackValue='4'}"
                                       AutomationId="ActiveRoundPage.ScoreValue"
                                       Style="{StaticResource Display}"
                                       TextColor="White"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Margin="0,-12,0,0"/>
                            </Border>

                            <Button Grid.Row="2"
                                    Text="+"
                                    AutomationId="ActiveRoundPage.IncreaseScore"
                                    Command="{Binding IncreaseScoreCommand}"
                                    HeightRequest="40"
                                    Padding="0"
                                    FontSize="28"
                                    Margin="0" />

                            <Label Grid.Row="3"
                                   Text="{Binding CurrentHole.ScoreRelativeToPar, StringFormat='{0:+0;-#;E}', FallbackValue='E'}"
                                   AutomationId="ActiveRoundPage.ScoreRelativeToPar"
                                   Style="{StaticResource Title2}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0" />
                        </Grid>

                        <!-- Proximity (right) -->
                        <VerticalStackLayout Grid.Column="2" Spacing="10">
                            <RadioButton GroupName="Proximity"
                                         HorizontalOptions="End"
                                         FlowDirection="RightToLeft"
                                         IsChecked="{Binding IsProximityS, Mode=TwoWay}" />
                            <Label Text="{ext:LocalizedUnits ProximityS}" HorizontalTextAlignment="End" Margin="0,-20,10,0" />

                            <RadioButton GroupName="Proximity"
                                         HorizontalOptions="End"
                                         FlowDirection="RightToLeft"
                                         IsChecked="{Binding IsProximityM, Mode=TwoWay}" />
                            <Label Text="{ext:LocalizedUnits ProximityM}" HorizontalTextAlignment="End" Margin="0,-20,10,0" />

                            <RadioButton GroupName="Proximity"
                                         HorizontalOptions="End"
                                         FlowDirection="RightToLeft"
                                         IsChecked="{Binding IsProximityL, Mode=TwoWay}" />
                            <Label Text="{ext:LocalizedUnits ProximityL}" HorizontalTextAlignment="End" Margin="0,-20,10,0" />
                        </VerticalStackLayout>

                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}"
                Margin="15,8,15,8"
                Padding="12"
                AutomationId="ActiveRoundPage.NavigationBar"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <!-- Navigation Buttons -->
            <Grid ColumnDefinitions="*,Auto,*">
                <Button Grid.Column="0"
                        Text="&lt;"
                        WidthRequest="72"
                        HeightRequest="44"
                        AutomationId="ActiveRoundPage.PreviousHole"
                        Command="{Binding PreviousHoleCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        HorizontalOptions="Start"/>

                <VerticalStackLayout Grid.Column="1"
                                    Spacing="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                    <Label Text="{Binding CurrentParNumberDisplay, FallbackValue='Par X'}"
                           AutomationId="ActiveRoundPage.Navigation.CurrentParDisplay"
                           Style="{StaticResource Title3}"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding CurrentHole.Yardage, Converter={StaticResource NullableIntToDashConverter}}"
                           AutomationId="ActiveRoundPage.Navigation.CurrentHoleYardage"
                           Style="{StaticResource Caption1}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="&gt;"
                        WidthRequest="72"
                        HeightRequest="44"
                        AutomationId="ActiveRoundPage.NextHole"
                        Command="{Binding NextHoleCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        HorizontalOptions="End"/>
            </Grid>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*,*"
              Padding="15,0,15,15"
              ColumnSpacing="10"
              RowSpacing="0"
              AutomationId="ActiveRoundPage.Actions"
              IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">

            <Button Grid.Column="0"
                    Text="{ext:Translate Abandon}"
                    AutomationId="ActiveRoundPage.Abandon"
                    Command="{Binding AbandonRoundCommand}"
                    HeightRequest="44"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>

            <Button Grid.Column="1"
                    Text="{ext:Translate CompleteRound}"
                    AutomationId="ActiveRoundPage.Complete"
                    Command="{Binding CompleteRoundCommand}"
                    HeightRequest="44"
                    BackgroundColor="{StaticResource Primary}"
                    IsVisible="{Binding IsLastHole}"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" 
              AutomationId="ActiveRoundPage.LoadingOverlay"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                             AutomationId="ActiveRoundPage.LoadingIndicator"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Color="{StaticResource Primary}"/>
        </Grid>
    </Grid>
</ContentPage>
