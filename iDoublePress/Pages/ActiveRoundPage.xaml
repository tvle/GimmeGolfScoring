<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:iDoublePress.Converters"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.ActiveRoundPage"
             x:DataType="pageModels:ActiveRoundPageModel"
             x:Name="RoundPage"
             AutomationId="ActiveRoundPage"
             Title="{ext:Translate ActiveRound}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:SubtractOneConverter x:Key="SubtractOneConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        
        <!-- Header: Score Summary -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="{StaticResource LayoutPadding}"
                AutomationId="ActiveRoundPage.Header"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <Grid ColumnDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Start">
                    <Label Text="{Binding CurrentRound.Course.Name, FallbackValue='Loading...'}" 
                           AutomationId="ActiveRoundPage.CourseName"
                           Style="{StaticResource Title3}"/>
                    <Label Text="{Binding HolesCompleted, FallbackValue='0/18'}" 
                           AutomationId="ActiveRoundPage.HolesCompleted"
                           Style="{StaticResource Caption1}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding CurrentRound.TotalScore, FallbackValue='0'}" 
                           AutomationId="ActiveRoundPage.TotalScore"
                           Style="{StaticResource LargeTitle}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding TotalScoreDisplay, FallbackValue='E'}" 
                           AutomationId="ActiveRoundPage.TotalScoreDisplay"
                           Style="{StaticResource Title2}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                    <Label Text="{Binding CurrentRound.StartTime, StringFormat='{0:h:mm tt}', FallbackValue='--:--'}" 
                           AutomationId="ActiveRoundPage.StartTime"
                           Style="{StaticResource Caption1}"/>
                    <Label Text="{Binding CurrentRound.Duration, StringFormat='{0:h\\:mm}', FallbackValue='0:00'}" 
                           AutomationId="ActiveRoundPage.Duration"
                           Style="{StaticResource Caption1}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Main Scorecard -->
        <ScrollView Grid.Row="1" AutomationId="ActiveRoundPage.Scorecard" IsVisible="{Binding CurrentHole, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Padding="{StaticResource LayoutPadding}" 
                                 Spacing="{StaticResource LayoutSpacing}">
                
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                        
                        <!-- Hole Header -->
                        <HorizontalStackLayout Grid.Row="0" 
                                               Spacing="10" 
                                               HorizontalOptions="Center"
                                               Margin="0,0,0,20"
                                               AutomationId="ActiveRoundPage.HoleHeader">
                            <Label Text="{Binding CurrentHoleDisplay, FallbackValue='Hole 1'}" 
                                   AutomationId="ActiveRoundPage.CurrentHoleDisplay"
                                   Style="{StaticResource Title1}"/>
                            <Label Text="{Binding CurrentParDisplay, FallbackValue='Par 4'}" 
                                   AutomationId="ActiveRoundPage.CurrentParDisplay"
                                   Style="{StaticResource Title2}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Decrease Button -->
                        <Button Grid.Row="1"
                                Text="-"
                                AutomationId="ActiveRoundPage.DecreaseScore"
                                Command="{Binding DecreaseScoreCommand}"
                                IsEnabled="{Binding CanDecreaseScore}"
                                HeightRequest="80"
                                FontSize="48"
                                Margin="0,10"/>

                        <!-- Score Display -->
                        <Border Grid.Row="2" 
                                AutomationId="ActiveRoundPage.ScoreDisplayContainer"
                                BackgroundColor="{Binding CurrentHole.ScoreColor, FallbackValue={StaticResource Primary}}"
                                StrokeThickness="0"
                                Padding="0"
                                Margin="0,20"
                                VerticalOptions="Center">
                            <Label Text="{Binding CurrentHole.Score, FallbackValue='4'}" 
                                   AutomationId="ActiveRoundPage.ScoreValue"
                                   Style="{StaticResource Display}"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>
                        </Border>

                        <!-- Increase Button -->
                        <Button Grid.Row="3"
                                Text="+"
                                AutomationId="ActiveRoundPage.IncreaseScore"
                                Command="{Binding IncreaseScoreCommand}"
                                HeightRequest="80"
                                FontSize="48"
                                Margin="0,10"/>

                        <!-- Score Type Label -->
                        <Label Grid.Row="4"
                               Text="{Binding CurrentHole.ScoreRelativeToPar, StringFormat='{0:+0;-#;E}', FallbackValue='E'}"
                               AutomationId="ActiveRoundPage.ScoreRelativeToPar"
                               Style="{StaticResource Title2}"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}"
                Margin="{StaticResource LayoutPadding}"
                AutomationId="ActiveRoundPage.NavigationBar"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <!-- Navigation Buttons -->
            <Grid Grid.Row="5" 
                              ColumnDefinitions="*,Auto,*"
                              Margin="0,20,0,0">
                <Button Grid.Column="0"
                                    Text="&lt;"
                                    WidthRequest="80"
                                    AutomationId="ActiveRoundPage.PreviousHole"
                                    Command="{Binding PreviousHoleCommand}"
                                    IsEnabled="{Binding CanGoBack}"
                                    HorizontalOptions="Start"/>

                <Label Grid.Column="1"
                                   Text="{Binding CurrentHoleDisplay, FallbackValue='Hole 1'}"
                                   AutomationId="ActiveRoundPage.Navigation.CurrentHoleDisplay"
                                   Style="{StaticResource Title3}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>

                <Button Grid.Column="2"
                                    Text="&gt;"
                                    WidthRequest="80"
                                    AutomationId="ActiveRoundPage.NextHole"
                                    Command="{Binding NextHoleCommand}"
                                    IsEnabled="{Binding CanGoForward}"
                                    HorizontalOptions="End"/>
            </Grid>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*,*"
              Padding="{StaticResource LayoutPadding}"
              ColumnSpacing="10"
              AutomationId="ActiveRoundPage.Actions"
              IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            
            <Button Grid.Column="0"
                    Text="{ext:Translate Abandon}"
                    AutomationId="ActiveRoundPage.Abandon"
                    Command="{Binding AbandonRoundCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
            
            <Button Grid.Column="1"
                    Text="{ext:Translate CompleteRound}"
                    AutomationId="ActiveRoundPage.Complete"
                    Command="{Binding CompleteRoundCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    IsVisible="{Binding IsLastHole}"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" 
              AutomationId="ActiveRoundPage.LoadingOverlay"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                             AutomationId="ActiveRoundPage.LoadingIndicator"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Color="{StaticResource Primary}"/>
        </Grid>
    </Grid>
</ContentPage>
