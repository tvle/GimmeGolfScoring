<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.CourseEditPage"
             x:DataType="pageModels:CourseEditPageModel"
             x:Name="CourseEditPageView"
             Title="{ext:Translate Courses}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CourseEditPageView}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
    </ContentPage.Behaviors>

    <Grid Padding="{StaticResource LayoutPadding}" RowDefinitions="Auto,*">
        <Border Style="{StaticResource CardStyle}" Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <VerticalStackLayout Spacing="10">
                    <Entry Text="{Binding Name}" Placeholder="{ext:Translate CourseName}" />
                    
                    <!-- Hole Count Selection -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" 
                                Style="{StaticResource CardStyle}"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding NumberOfHoles}" Value="9">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetHoleCountCommand}" CommandParameter="9" />
                            </Border.GestureRecognizers>
                            <Label Text="9 Holes" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"
                                   Style="{StaticResource Title3}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding NumberOfHoles}" Value="9">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        
                        <!-- Total Par in center -->
                        <Label Grid.Column="1"
                               Text="{Binding TotalPar, StringFormat='{0}'}"
                               Style="{StaticResource Title2}"
                               FontSize="28"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="10,0" />
                        
                        <Border Grid.Column="2" 
                                Style="{StaticResource CardStyle}"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding NumberOfHoles}" Value="18">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetHoleCountCommand}" CommandParameter="18" />
                            </Border.GestureRecognizers>
                            <Label Text="18 Holes" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"
                                   Style="{StaticResource Title3}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding NumberOfHoles}" Value="18">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                    
                    <Button Text="{ext:Translate Save}" Command="{Binding SaveCommand}" />

                    <!-- Course Rating and Slope -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" 
                                   Text="{ext:Translate CourseRating}" 
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding CourseRating}" 
                                   Placeholder="{ext:Translate CourseRatingPlaceholder}"
                                   Keyboard="Numeric" />
                        </Grid>
                        
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" 
                                   Text="{ext:Translate SlopeRating}" 
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Slope}" 
                                   Placeholder="{ext:Translate SlopeRatingPlaceholder}"
                                   Keyboard="Numeric" />
                        </Grid>
                    </Grid>
				</VerticalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Holes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CourseHole">
                    <Border Style="{StaticResource CardStyle}" Margin="0,5">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center" Padding="10">
                            <Label Text="{Binding HoleNumber, StringFormat='#{0}'}" 
                                   VerticalOptions="Center" 
                                   Style="{StaticResource Title3}"
                                   MinimumWidthRequest="40" />

                            <Button Grid.Column="2"
                                    Text="-"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    Clicked="OnDecrementParClicked"
                                    CommandParameter="{Binding .}" />
                            <Label Grid.Column="3" 
                                   Text="{Binding Par}" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   Style="{StaticResource Title2}"
                                   MinimumWidthRequest="30"
                                   HorizontalTextAlignment="Center" />
                            <Button Grid.Column="4"
                                    Text="+"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    Clicked="OnIncrementParClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
