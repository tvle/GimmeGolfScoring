<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.ShowGPSPage"
             x:DataType="pageModels:ShowGPSPageModel"
             x:Name="ThisPage"
             Title="{Binding CurrentRound.Course.Name, FallbackValue='Standard Course'}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Padding="15" RowSpacing="15">

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" VerticalOptions="Start">
            <Grid Padding="10" ColumnDefinitions="Auto, *">
                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Start">
                    <Label Text="#" />
                    <Label Text="{Binding CurrentHoleNumberDisplay}"
                                Style="{StaticResource Title1}"
                                FontSize="32"
                                VerticalOptions="Center"
                                AutomationId="ShowGPSPage.HoleNumber" />
                    <Label Text="{Binding CurrentParNumberDisplay}" Margin="10,0,0,0"
                            Style="{StaticResource Title2}"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            AutomationId="ShowGPSPage.Par" />
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="📍"
                        Command="{Binding ToggleMeasurementCommand}"
                        HorizontalOptions="End"/>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ShotSegments}"
                        SelectionMode="None"
                        EmptyView="----"
                        VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShotSegment">
                    <Border Style="{StaticResource CardStyle}" Margin="0,5">
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              Padding="8"
                              ColumnSpacing="10"
                              RowSpacing="6"
                              VerticalOptions="Center">

                            <Label Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Text="{Binding DistanceDisplay}" 
                                    FontSize="18" 
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Primary}"
                                    LineBreakMode="TailTruncation" 
                                    Style="{StaticResource Body1}"/>

                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Text="🏷️"
                                    Clicked="TagButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Button Grid.Row="0"
                                    Grid.Column="3"
                                    ImageSource="{StaticResource IconDeleteWhite}"
                                    Clicked="DeleteButton_Clicked"
                                    CommandParameter="{Binding .}"
                                    Padding="10,4" />

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="4" 
                                   Text="{Binding Tag}"
                                    FontSize="18" 
                                    FontAttributes="Bold"
                                    TextColor="OrangeRed"
                                    LineBreakMode="TailTruncation" 
                                    Style="{StaticResource Body1}"/>
                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="4"
                                   Text="{Binding LocationDisplay}"
                                   Style="{StaticResource Caption1}"
                                   Opacity="0.6"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}"
                Margin="10,8,10,8"
                Padding="4"
                AutomationId="ShowGPSPage.NavigationBar"
                IsVisible="{Binding CurrentRound, Converter={StaticResource IsNotNullConverter}}">
            <!-- Navigation Buttons -->
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Text="&lt;"
                        WidthRequest="72"
                        HeightRequest="44"
                        Padding="0,-0,0,0"
                        AutomationId="ShowGPSPage.Back"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"/>

            </Grid>
        </Border>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
              ZIndex="99">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </Grid>
    </Grid>
</ContentPage>