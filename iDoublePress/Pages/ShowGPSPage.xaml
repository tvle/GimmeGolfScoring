<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:iDoublePress.PageModels"
             xmlns:models="clr-namespace:iDoublePress.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:iDoublePress.Extensions"
             x:Class="iDoublePress.Pages.ShowGPSPage"
             x:DataType="pageModels:ShowGPSPageModel"
             x:Name="ThisPage"
             Title="{ext:Translate GPSPageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="15">

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" VerticalOptions="Start">
            <Grid Padding="10">
                <Button Text="📍 Mark Location"
                        Command="{Binding ToggleMeasurementCommand}"
                        HorizontalOptions="Fill"/>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1" x:Name="ShotList"
                        ItemsSource="{Binding ShotSegments}"
                        EmptyView="----">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShotSegment">
                    <Grid ColumnDefinitions="80, *, 50" Padding="0,8">

                        <Label Grid.Column="0" 
                               Text="{Binding DistanceDisplay}" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1" 
                               Text="{Binding LocationDisplay}" 
                               FontSize="14" 
                               TextColor="Gray"
                               VerticalOptions="Center"/>
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                ImageSource="{StaticResource IconDeleteWhite}"
                                Clicked="Button_Clicked"
                                CommandParameter="{Binding .}"
                                Padding="10,4" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
              ZIndex="99">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </Grid>
    </Grid>
</ContentPage>